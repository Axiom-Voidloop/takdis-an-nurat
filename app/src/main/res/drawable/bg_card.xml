<?xml version="1.0" encoding="utf-8"?>
<!-- A gray card. The gradient runs from top to bottom, and its direction is the opposite in the black theme. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="@color/takdis_card_end"
        android:startColor="@color/takdis_card_start"
        android:type="linear" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="@color/takdis_border" />
</shape>
